generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum Role {
  admin
  secretary
  claim_adjuster
  gio_principal_claim_officer
  surveyor
  principal_claim_officer
  claim_manager
  gio_claim_manager
  director
  senior_director
  chief_of_gio
  ceo
}

enum WorkLocationType {
  Head_Office
}

enum Department {
  GIO
  Claim_Division
}

enum Gender {
  Male
  Female
}

enum StaffStatus {
  Active
  Inactive
}

enum InsuranceType {
  Motor
  Fire
  Marine
  Engineering
  Liability
  Agriculture
  Life
  Health
  GPA
  CPM
  WC
  Money
  PVT
  WMC
  Bond
  Aviation
  Marine_Hull
  Other
}

enum OriginatingOfficeType {
  Service_Center
  District_Office
  Kefla_Ager_Branch
  Border_Branch
  Head_Office
}

enum WorkflowType {
  Claim_Division
  GIO_Approval
}

enum GioCaseReason {
  Standard_Claim_Approval
  Work_Order_Approval
  Additional_WO_Approval
  Claim_Within_15_Days_Case
  Repair_Approval
  Total_Loss_Approval
  Additional_Repair_Approval
  Payment_Approval
  Direct_Cash_Payment_Approval
  Vendor_Payment_Approval
  Legal_Expense_Approval
  Advice_Request
  Legal_Advice
  Technical_Advice
  Third_Party_Recovery_Advice
  Cash_Option_Approval
  Less_Salvage_Verification
  Ex_gratia_Claim_Approval
  Customer_Complaint_Handling
  Other_Management_Decisions
}

enum ClaimStatus {
  // Shared / legacy
  Draft
  Submitted
  Under_Review
  Returned
  Escalated
  Additional_Info_Requested

  // Claim Division (stage-mapped)
  Notification_Received
  Claim_Registered
  Pending_Assignment
  Assigned_to_Claim_Adjuster
  Survey_in_Progress
  Bid_Tender_in_Progress
  Decision_Pending
  Work_Order_Pending
  Work_Order_Approved
  Payment_Preparation
  Payment_Approved
  Claim_Closed
  Returned_for_Correction
  Escalated_to_GIO

  // GIO case statuses
  Case_Received
  Pending_GIO_Assignment
  Director_Assignment_Pending
  Manager_Assignment_Pending
  Assigned_to_GIO_Principal
  Document_Review_Pending
  GIO_Review_In_Progress
  Claim_Manager_Review_Pending
  Director_Decision_Pending
  Senior_Director_Decision_Pending
  Chief_of_GIO_Approval_Pending
  CEO_Approval_Pending
  Returned_to_Originating_Office
  Completed
  Closed

  // Shared terminal
  Approved
  Rejected
}

enum CurrentApproverRole {
  Principal_of_Claim
  Claim_Manager
  GIO_Claim_Manager
  Director
  Chief_of_GIO
  CEO
  None
}

enum Priority {
  Low
  Medium
  High
  Urgent
}

enum CurrentDepartment {
  GIO
  Claim_Division
}

enum RegistrationType {
  New_Claim_Notification
  Subrogation
  Third_Party_Recovery
  Reinsurance
}

enum ThresholdInsuranceType {
  Motor
  Fire
  Marine
  Engineering
  Liability
  Agriculture
  Life
  Health
  GPA
  Money
  PVT
  WMC
  Bond
  Aviation
  Marine_Hull
  Other
  All
}

enum RequiredApproverRole {
  Principal_of_Claim
  Claim_Manager
  GIO_Claim_Manager
  Director
  Chief_of_GIO
  CEO
}

enum ClaimActionType {
  Registered
  Assigned
  Forwarded
  Approved
  Rejected
  Returned_for_Correction
  Escalated
  Status_Changed
  Comment_Added
  Closed
  // keep legacy so old rows still load
  Submitted
  Returned
  Additional_Info_Requested
  Resubmitted
  Comment
}

enum ActivityStatus {
  Pending
  In_Progress
  Completed
  Skipped
  On_Hold
}

enum GarageStatus {
  Proforma_Requested
  Proforma_Received
  Tender_Under_Review
  Work_Order_Issued
  Repair_In_Progress
  Repair_Completed
  Survey_After_Repair
  Invoice_Settled
}

enum NotificationType {
  approval_required
  claim_approved
  claim_rejected
  claim_returned
  claim_escalated
  info_requested
  general
  // Admin / security
  account_locked
  password_changed
  security_alert
  system_health
  backup_failed
}

enum WorkflowStageType {
  Claim_Division
  GIO_Approval
  Both
}

enum WorkflowDepartment {
  GIO
  Claim_Division
}

// ==================== MODELS ====================

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  password           String
  role               Role             @default(claim_adjuster)
  work_location_type WorkLocationType @default(Head_Office)
  must_change_password Boolean        @default(false)
  failed_login_attempts Int           @default(0)
  locked_until       DateTime?
  session_id         String?
  department         Department?
  work_location      String?
  phone              String?
  position_title     String?
  profile_image_url  String?
  is_active          Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  notifications      Notification[]
}

model StaffMember {
  id                 String           @id @default(cuid())
  email              String           @unique
  first_name         String
  middle_name        String?
  last_name          String
  gender             Gender?
  phone              String?
  role               Role             @default(claim_adjuster)
  work_location_type WorkLocationType @default(Head_Office)
  department         Department?
  work_location      String?
  joining_date       DateTime?
  employee_id        String?
  status             StaffStatus      @default(Active)
  invited            Boolean          @default(false)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Claim {
  id                         String                 @id @default(cuid())
  claim_reference            String                 @unique
  policy_number              String?
  claimant_name              String
  injured_name               String?
  insurance_type             InsuranceType
  cover_type                 String?
  plate_number               String?
  claim_amount               Float
  incident_date              DateTime
  incident_description       String?
  originating_office         String?
  originating_office_type    OriginatingOfficeType?
  received_reference_number  String?
  date_received               DateTime?
  claim_number               String?
  final_approval_amount      Float?
  motor_vehicle_type         String?
  is_rebid                   Boolean  @default(false)
  rebid_participating_garages String[] @default([])
  rebid_winner_garage        String?
  garage_name                String?
  has_independent_assessor   Boolean  @default(false)
  independent_assessor_name  String?
  workflow_type               WorkflowType           @default(Claim_Division)
  gio_case_reason              GioCaseReason?
  status                     ClaimStatus            @default(Draft)
  current_approver_role      CurrentApproverRole    @default(None)
  current_approver_id        String?
  submitted_by_id            String?
  submitted_by_name          String?
  submission_date            DateTime?
  approval_date               DateTime?
  rejection_reason            String?
  rejection_date              DateTime?
  remarks                     String?
  documents                   String[]
  priority                    Priority               @default(Medium)
  approval_level              Int                    @default(0)
  max_approval_level          Int?
  return_count                 Int                    @default(0)
  workflow_stage               String?
  workflow_stage_order         Int                    @default(0)
  current_owner_id             String?
  current_owner_name           String?
  current_department           CurrentDepartment?
  assigned_performer_id        String?
  assigned_performer_name      String?
  assignment_date              DateTime?
  due_date                     DateTime?
  closure_date                 DateTime?
  insis_registered              Boolean                @default(false)
  registration_type             RegistrationType?
  registration_data             Json?
  is_subrogation                 Boolean                @default(false)
  is_recovery                    Boolean                @default(false)
  is_reinsurance                 Boolean                @default(false)
  registration_complete          Boolean                @default(false)
  is_deleted Boolean                                    @default(false)
  deleted_at                     DateTime?
  deleted_by_id                  String?
  registration_completed_by_id   String?
  registration_completed_by_name String?
  registration_completed_at      DateTime?

  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  activities                     ClaimActivity[]
  actions                        ClaimAction[]
  garages                        ClaimGarage[]
  notifications                  Notification[]
}

model ApprovalThreshold {
  id                     String                 @id @default(cuid())
  insurance_type         ThresholdInsuranceType
  min_amount             Float
  max_amount             Float
  required_approver_role RequiredApproverRole
  approval_chain         String[]
  is_active              Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

model ClaimAction {
  id                          String          @id @default(cuid())
  claim_id                    String
  claim_reference             String?
  action_type                 ClaimActionType
  from_stage                  String?
  to_stage                    String?
  from_status                 String?
  to_status                   String?
  action_by_id                String
  action_by_name              String
  action_by_role              String?
  previous_responsible_person String?
  new_responsible_person      String?
  comments                    String?         // remarks
  workflow_type               WorkflowType?
  from_level                  Int?
  to_level                    Int?
  documents                   String[]
  createdAt                   DateTime        @default(now())
  claim                       Claim           @relation(fields: [claim_id], references: [id], onDelete: Cascade)
}

model ClaimActivity {
  id                    String         @id @default(cuid())
  claim_id              String
  claim_reference       String?
  stage_name            String
  stage_order           Int
  status                ActivityStatus @default(Pending)
  responsible_user_id   String?
  responsible_user_name String?
  responsible_role      String?
  department            String?
  started_at            DateTime?
  completed_at          DateTime?
  comments              String?
  documents             String[]
  is_overdue             Boolean        @default(false)
  due_date               DateTime?
  registration_data      Json?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  claim                   Claim          @relation(fields: [claim_id], references: [id], onDelete: Cascade)
}

model ClaimGarage {
  id                 String       @id @default(cuid())
  claim_id           String
  claim_reference    String?
  garage_name        String
  garage_location    String?
  work_order_number  String?
  work_order_date    DateTime?
  estimated_amount   Float?
  final_amount       Float?
  repair_description String?
  status             GarageStatus @default(Proforma_Requested)
  start_date         DateTime?
  completion_date    DateTime?
  assigned_by_id     String?
  assigned_by_name   String?
  is_selected        Boolean      @default(false)
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  claim              Claim        @relation(fields: [claim_id], references: [id], onDelete: Cascade)
}

model Garage {
  id        String   @id @default(cuid())
  name      String   @unique
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Notification {
  id              String           @id @default(cuid())
  user_id         String
  claim_id        String?
  claim_reference String?
  title           String
  message         String
  type            NotificationType @default(general)
  is_read         Boolean          @default(false)
  createdAt       DateTime         @default(now())
  user            User?            @relation(fields: [user_id], references: [id])
  claim           Claim?           @relation(fields: [claim_id], references: [id])
}

model WorkflowStage {
  id                         String               @id @default(cuid())
  stage_name                 String
  description                String?
  stage_order                Int
  responsible_role           Role
  workflow_type              WorkflowStageType    @default(Claim_Division)
  workflow_stream            String?              @default("New_Claim")
  applicable_insurance_types String[]
  applicable_office_types    String[]             @default([])
  sla_days                   Int?
  department                 WorkflowDepartment?
  is_active                  Boolean              @default(true)
  is_configurable            Boolean              @default(true)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
}

model SystemSettings {
  id                                String   @id @default(cuid())
  key                               String   @unique @default("singleton")

  audit_enabled                     Boolean  @default(true)
  audit_retention_days              Int      @default(365)
  audit_track_login_logout          Boolean  @default(true)
  audit_track_claim_actions         Boolean  @default(true)
  audit_track_gio_actions           Boolean  @default(true)
  audit_track_user_actions          Boolean  @default(true)
  audit_track_document_actions      Boolean  @default(true)
  audit_track_settings_changes      Boolean  @default(true)
  audit_export_allowed_roles        String[] @default(["admin"])

  system_name                       String   @default("EIC Claim Management System")
  organization_name                 String   @default("Ethiopian Insurance Corporation (EIC)")
  system_version                    String   @default("1.0.0")
  environment                       String   @default("Production")
  timezone                          String   @default("Africa/Addis_Ababa")
  date_format                       String   @default("DD MMM YYYY")
  time_format                       String   @default("HH:mm")
  default_currency                  String   @default("ETB")
  system_logo_url                   String?
  application_status                String   @default("Active")
  last_system_update                DateTime?

  doc_max_upload_mb                 Int      @default(10)
  doc_allowed_types                 String[] @default(["pdf", "jpg", "jpeg", "png", "docx", "xlsx"])
  doc_categories                    String[] @default(["Claim Form", "Police Report", "Photos", "Invoice", "Medical Report", "Other"])
  doc_max_files_per_submission      Int      @default(10)
  doc_allow_replace                 Boolean  @default(true)
  doc_allow_download                Boolean  @default(true)
  doc_allow_delete                  Boolean  @default(false)
  doc_require_remarks_on_change     Boolean  @default(true)

  sec_min_password_length           Int      @default(8)
  sec_require_uppercase             Boolean  @default(true)
  sec_require_number                Boolean  @default(true)
  sec_require_special_char          Boolean  @default(false)
  sec_max_failed_attempts           Int      @default(5)
  sec_lockout_minutes               Int      @default(15)
  sec_jwt_expiry_minutes            Int      @default(60)
  sec_session_expiry_hours          Int      @default(24)
  sec_auto_logout_minutes           Int      @default(30)
  sec_require_password_change_new_account Boolean @default(true)
  sec_prevent_password_reuse_count  Int      @default(3)
  sec_enable_security_notifications Boolean  @default(true)

  updatedAt                         DateTime @updatedAt
  updated_by_id                     String?
  updated_by_name                   String?
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model DataAuditLog {
  id          String      @id @default(cuid())
  entityType  String      // "Claim", "StaffMember", "ApprovalThreshold", "WorkflowStage", "User"
  entityId    String
  action      AuditAction
  changes     Json?       // { field: { old, new } }
  actorId     String?
  actorName   String?
  actorRole   Role?       // reuse your existing Role enum — captures role AT time of action
  requestId   String?     // correlates to AccessLog.requestId
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model AccessLog {
  id           String    @id @default(cuid())
  requestId    String    @unique
  actorId      String?
  actorRole    Role?
  method       String
  path         String
  statusCode   Int?
  ip           String?
  userAgent    String?
  action       String?   // "LOGIN_SUCCESS" | "LOGIN_FAILED" | "VIEW_CLAIM" | "EXPORT" | "API_CALL"
  claimId      String?   // set when the request targets a specific claim — huge for "who viewed claim X"
  durationMs   Int?
  createdAt    DateTime  @default(now())

  @@index([actorId])
  @@index([claimId])
  @@index([path])
  @@index([createdAt])
  @@index([ip])
}